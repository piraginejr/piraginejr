# Ambiente Power Church

POWER_CHURCH_ENV=development
POWER_CHURCH_HOST=127.0.0.1
POWER_CHURCH_PORT=0
POWER_CHURCH_DB_PATH=data/power_church_membros_importado.db
POWER_CHURCH_PDF_PROVIDER=swift_pdfkit
POWER_CHURCH_BACKUP_DIR=data/backups

# Django paralelo
POWER_CHURCH_DJANGO_SECRET_KEY=dev-only-change-before-production
POWER_CHURCH_DJANGO_DEBUG=true
POWER_CHURCH_DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
POWER_CHURCH_DJANGO_DB_PATH=data/power_church_django.sqlite3
POWER_CHURCH_LEGACY_DB_PATH=data/power_church_membros_importado.db

# PostgreSQL futuro/staging Django
