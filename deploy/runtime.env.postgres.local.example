# Runtime local Docker do Power Church PostgreSQL
# Copie este arquivo para:
#   ../power_church_postgres_runtime/env/runtime.env
# e ajuste apenas os segredos/dominio quando necessario.

POWER_CHURCH_DJANGO_SECRET_KEY=change-me-before-cloud
POWER_CHURCH_DJANGO_DEBUG=false
POWER_CHURCH_DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

POWER_CHURCH_POSTGRES_DB=power_church
POWER_CHURCH_POSTGRES_USER=power_church
POWER_CHURCH_POSTGRES_PASSWORD=power_church_dev
POWER_CHURCH_POSTGRES_HOST=postgres-runtime
POWER_CHURCH_POSTGRES_PORT=5432
POSTGRES_DB=power_church
POSTGRES_USER=power_church
POSTGRES_PASSWORD=power_church_dev

# Mantido separado so como referencia historica e apoio tecnico.
POWER_CHURCH_LEGACY_DB_PATH=/app/data/power_church_membros_importado.db

POWER_CHURCH_BRAND_LOGO_PATH=/app/data/branding/power_church_logo.jpg
POWER_CHURCH_ENVELOPE_DIR=/app/data/envelope_uploads
POWER_CHURCH_PHOTO_DIR=/app/data/fotos_membros
POWER_CHURCH_BACKUP_DIR=/app/data/backups

# Ambiente seguro para homologacao local sem envio real.
POWER_CHURCH_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
POWER_CHURCH_DEFAULT_FROM_EMAIL=recebimento@localhost
POWER_CHURCH_RECEIPT_REPLY_TO=
POWER_CHURCH_RECEIPT_AUTO_EMAIL_ENABLED=false
POWER_CHURCH_RECEIPT_AUTO_SEND_ENABLED=false

POWER_CHURCH_DATA_UPLOAD_MAX_NUMBER_FILES=5000
POWER_CHURCH_DATA_UPLOAD_MAX_NUMBER_FIELDS=20000
